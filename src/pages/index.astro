---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';

const alimento = [
  { name: 'Croquetas Premium para Perro', price: 600, image: 'https://www.ganador.com.mx/wp-content/uploads/2023/05/render-adulto-rp.png', fit: 'contain' },
  { name: 'Comida Húmeda para Gato', price: 30, image: 'https://purina.com.gt/sites/default/files/styles/webp/public/2023-10/Sobre_Felix_Adulto_Pollo_1.png.webp?itok=4v8qkaeJA', fit: 'contain' },
  { name: 'Alimento Natural para Cachorros', price: 500, image: 'https://eranaturals.mx/cdn/shop/files/57_d0dcf1a7-2e89-4523-b76b-ddfc0151bccb.png?v=1740596580', fit: 'contain' },
  { name: 'Era Naturals Adulto Raza Mediana y Grande', price: 469, image: 'https://eranaturals.mx/cdn/shop/files/20kg_Adulto.png?v=1740596528', fit: 'contain' }
];

const juguetes = [
  { name: 'Pelota Resistente', price: 70, image: 'https://images.unsplash.com/photo-1669891340245-5b787bb7fa70?auto=format&fit=crop&w=600&q=80' },
  { name: 'Ratón de Juguete Felpa', price: 99, image: 'https://images.unsplash.com/photo-1638826595775-e2eae86cda8e?auto=format&fit=crop&w=600&q=80' },
  { name: 'Cuerda Trenzada Multicolor', price: 50, image: 'https://images.unsplash.com/photo-1723296014357-808b32c57d98?auto=format&fit=crop&w=600&q=80' },
  { name: 'Comedero Rompecabezas', price: 250, image: 'https://images.unsplash.com/photo-1678783133022-89e103910f76?auto=format&fit=crop&w=600&q=80' },
];

const cuidado = [
  { name: 'Shampoo Antipulgas', price: 89, image: 'https://www.lacomer.com.mx/superc/img_art/7501022107010_3.jpg', fit: 'contain' },
  { name: 'Cepillo Quitapelos para Mascotas', price: 120, image: 'https://m.media-amazon.com/images/I/71ECpqwKSdL.jpg', fit: 'contain' },
  { name: 'Cortaúñas de Seguridad', price: 99, image: 'https://http2.mlstatic.com/D_NQ_NP_790208-CBT113616008492_072026-O.webp', fit: 'contain' },
  { name: 'Cepillo Dental y Pasta', price: 60, image: 'https://i5.walmartimages.com/asr/aa9fde20-209a-4f47-80a1-bfb449856ea6.b2642d4caa69ada25724069ccc4dc81c.jpeg?odnHeight=612&odnWidth=612&odnBg=FFFFFF', fit: 'contain' },
];
---

<Layout
	title="Patitas felices"
  description="Todo lo que necesites para tu mascota."
>
  <Header />
  <main>
    <Hero
      title="Software inteligente para escalar tu negocio"
      subtitle="En Kodiq diseñamos e implementamos soluciones digitales robustas, rápidas y hechas a la medida de tus necesidades."
    />

    <section id="alimento" class="products-section">
      <div class="section-header">
        <span class="section-badge">🍖 Alimentación</span>
        <h2 class="section-title">Alimento para tu mascota</h2>
        <p class="section-description">
          Nutrición completa y balanceada con las mejores marcas para que tu fiel amigo crezca sano y lleno de energía.
        </p>
      </div>
      <div class="products-grid">
        {alimento.map((product) => (
          <ProductCard name={product.name} price={product.price} image={product.image} fit={product.fit} />
        ))}
      </div>
    </section>

    <section id="juguetes" class="products-section">
      <div class="section-header">
        <span class="section-badge">🎾 Diversión</span>
        <h2 class="section-title">Juguetes para jugar sin parar</h2>
        <p class="section-description">
          Estimula su mente y cuerpo con juguetes resistentes y divertidos, perfectos para horas de entretenimiento.
        </p>
      </div>
      <div class="products-grid">
        {juguetes.map((product) => (
          <ProductCard name={product.name} price={product.price} image={product.image} fit={product.fit} />
        ))}
      </div>
    </section>

    <section id="cuidado" class="products-section">
      <div class="section-header">
        <span class="section-badge">🛁 Bienestar</span>
        <h2 class="section-title">Cuidado e higiene</h2>
        <p class="section-description">
          Todo lo necesario para mantener a tu mascota limpia, saludable y siempre radiante.
        </p>
      </div>
      <div class="products-grid">
        {cuidado.map((product) => (
          <ProductCard name={product.name} price={product.price} image={product.image} fit={product.fit} />
        ))}
      </div>
    </section>

    <section id="nosotros" class="products-section">
      <div class="section-header">
        <span class="section-badge">🐾 Sobre nosotros</span>
        <h2 class="section-title">Patitas Felices</h2>
        <p class="section-description">
          Somos una tienda dedicada al bienestar de perros y gatos. Seleccionamos alimento, juguetes y
          productos de cuidado de marcas confiables para que cuidar a tu fiel amigo sea fácil y sin complicaciones.
        </p>
      </div>

      <div class="about-grid">
        <article class="about-card">
          <h3 class="about-title">Qué hacemos</h3>
          <p class="about-text">
            Vendemos en línea alimento, juguetes y artículos de cuidado e higiene para mascotas, con
            envío rápido hasta la puerta de tu casa.
          </p>
        </article>

        <article class="about-card">
          <h3 class="about-title">Qué problema resolvemos</h3>
          <p class="about-text">
            Evitamos que tengas que recorrer varias tiendas buscando lo necesario: aquí encuentras todo
            en un solo lugar, con marcas de calidad y precios claros.
          </p>
        </article>

        <article class="about-card">
          <h3 class="about-title">A quién va dirigido</h3>
          <p class="about-text">
            A dueños de perros y gatos que quieren consentir a sus mascotas con productos seguros y
            que valoran su tiempo y su bolsillo.
          </p>
        </article>

        <article class="about-card">
          <h3 class="about-title">Qué nos diferencia</h3>
          <p class="about-text">
            Curadores de producto según la necesidad de cada mascota, asesoría cercana, envíos rápidos y
            la confianza de más de 5,000 clientes felices.
          </p>
        </article>
      </div>
    </section>

    <section id="contacto" class="products-section">
      <div class="section-header">
        <span class="section-badge">📞 Contacto</span>
        <h2 class="section-title">¿Hablamos?</h2>
        <p class="section-description">
          Escríbenos por el medio que prefieras: con gusto te asesoramos para elegir lo mejor para tu mascota.
        </p>
      </div>

      <div class="contact-layout">
        <div class="contact-info">
          <div class="contact-item">
            <h3 class="contact-title">Dirección</h3>
            <p class="contact-text">
              Av. de las Mascotas 123, Col. Centro,<br />
              Ciudad de México, CDMX.
            </p>
          </div>

          <div class="contact-item">
            <h3 class="contact-title">WhatsApp</h3>
            <p class="contact-text">
              Escríbenos para pedir o cotizar:<br />
              <a class="contact-link" href="https://wa.me/525512345678">+52 55 1234 5678</a>
            </p>
          </div>

          <div class="contact-item">
            <h3 class="contact-title">Horario de atención</h3>
            <p class="contact-text">
              Lunes a sábado de 9:00 a 19:00 h.<br />
              Domingos: solo pedidos en línea.
            </p>
          </div>
        </div>

        <div class="contact-social">
          <h3 class="contact-title">Redes sociales</h3>
          <p class="contact-text">
            Síguenos para promos, tips y novedades para tu mascota.
          </p>
          <div class="social-links">
            <a class="social-link" href="https://instagram.com/patitasfelicesmx" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a class="social-link" href="https://facebook.com/patitasfelicesmx" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a class="social-link" href="https://tiktok.com/@patitasfelicesmx" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
            <a class="social-link" href="https://x.com/patitasfelicesmx" aria-label="X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .products-section {
    background-color: var(--bg-main);
    padding: 4rem 1rem;
  }

  .products-section + .products-section {
    border-top: 1px solid var(--border-color);
  }

  @media (min-width: 768px) {
    .products-section {
      padding: 5rem 2rem;
    }
  }

  .section-header {
    max-width: 1200px;
    margin: 0 auto 2.5rem auto;
    text-align: center;
  }

  .section-badge {
    display: inline-block;
    background-color: rgba(249, 115, 22, 0.1);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
  }

  .section-description {
    color: var(--text-muted);
    font-size: 1.125rem;
    max-width: 42rem;
    margin: 0 auto;
  }

  .products-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .about-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .about-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  .about-text {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-layout {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
  }

  .contact-text {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  .contact-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .contact-social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .social-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .social-link:hover {
    color: #fff;
    background-color: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
</style>