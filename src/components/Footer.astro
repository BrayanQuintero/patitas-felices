<style>
  .footer {
    background-color: var(--card-bg);
    border-top: 1px solid var(--border-color);
    padding: 3.5rem 1rem 1.5rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--text-main);
  }

  .footer-logo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    background-color: rgba(249, 115, 22, 0.1);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    font-size: 1.15rem;
  }

  .footer-accent {
    color: var(--primary);
  }

  .footer-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 1rem 0;
  }

  .footer-text {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 1rem 0 0 0;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-list li {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-list a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-list a:hover {
    color: var(--accent);
  }

  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
  }

  .footer-social-link svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .footer-social-link:hover {
    color: #fff;
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (min-width: 768px) {
    .footer-bottom p {
      text-align: left;
    }
  }
</style>

