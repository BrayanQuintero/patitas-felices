---
const {
  image = 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=600&q=80',
  name = 'Producto',
  price = 0,
  fit = 'cover',
} = Astro.props;
---

<article class="product-card">
  <div class={`product-image ${fit === 'contain' ? 'is-contain' : ''}`}>
    <img src={image} alt={name} loading="lazy" />
  </div>

  <div class="product-body">
    <h3 class="product-name">{name}</h3>
    <p class="product-price">${price.toLocaleString('es-CO')}</p>
    <button class="product-button" type="button" aria-label={`Comprar ${name}`}>
      Comprar
    </button>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 25px 30px -10px rgba(0, 0, 0, 0.15);
  }

  .product-image img {
    width: 100%;
    height: 14rem;
    object-fit: cover;
    display: block;
  }

  .product-image.is-contain {
    background-color: var(--card-bg);
  }

  .product-image.is-contain img {
    object-fit: contain;
    padding: 0.5rem;
  }

  .product-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
    padding: 1.25rem;
  }

  .product-name {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .product-price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary);
  }

  .product-button {
    margin-top: auto;
    background-color: var(--primary);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 0.75rem;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.2);
    transition: background-color 0.2s;
  }

  .product-button:hover {
    background-color: var(--primary-hover);
  }
</style>